{
  "name": "agent-code",
  "version": "0.1.0",
  "description": "A tutorial-built coding agent CLI",
  "type": "module",
  "bin": {
    "agent-code": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
