{
  "name": "dugsyn",
  "version": "0.2.0",
  "description": "独孤信多面体煤精组印 CLI — a multi-faceted coding agent forged from the best of industry tools",
  "type": "module",
  "bin": {
    "dugsyn": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --watch src/cli/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:eval": "vitest run --config vitest.config.ts tests/unit/observability.test.ts tests/integration/eval-runner.test.ts",
    "test:subagents": "vitest run --config vitest.config.ts tests/integration/subagent-worktree.test.ts",
    "test:lsp": "vitest run --config vitest.config.ts tests/integration/lsp-plugin.test.ts",
    "test:hosts": "vitest run --config vitest.config.ts tests/unit/host-extensions.test.ts",
    "test:mvp": "vitest run --config vitest.config.ts tests/integration/mvp-flow.test.ts",
    "test:mvp:live": "vitest run --config vitest.config.ts tests/integration/mvp-live-smoke.test.ts",
    "test:mvp:live:local": "node scripts/run-mvp-live-local.mjs",
    "test:smoke": "vitest run --config vitest.config.ts tests/integration/provider-smoke.test.ts",
    "test:smoke:local": "node scripts/run-smoke-local.mjs",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "undici": "^7.28.0",
    "vscode-jsonrpc": "^9.0.1",
    "zod": "^4.4.3"
  }
}
